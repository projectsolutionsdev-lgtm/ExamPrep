# MongoDB Atlas Database Connection URI (set in Render Environment Variables; never commit real credentials)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="My_Db"

# Render Backend-Only & CORS Configuration
BACKEND_ONLY="true"
CORS_ORIGINS="https://exam-prep-dev-4319-f847.vercel.app"

# Vercel Frontend -> Render Backend API Base URL
VITE_API_BASE_URL="https://examprep-dz09.onrender.com"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
